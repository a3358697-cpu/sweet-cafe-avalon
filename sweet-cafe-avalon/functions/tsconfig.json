{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "lib"
  },
  "include": ["src/**/*.ts", "../src/rules.ts"],
  "exclude": ["src/**/*.test.ts"]
}
